# Copie para .env e preencha. NUNCA suba o .env para o GitHub.
SECRET_KEY=troque-por-uma-chave-longa-e-aleatoria
DATABASE_PATH=instance/docemila.db
# Produção: use um PostgreSQL externo para os dados não se perderem (veja o README).
# Exemplo: postgresql://usuario:senha@host/banco?sslmode=require
DATABASE_URL=

# Origens autorizadas a chamar a API (separe por vírgula)
CORS_ORIGINS=http://localhost:3000
FRONTEND_URL=http://localhost:3000
# URL pública da API (necessária para o webhook do Mercado Pago)
API_PUBLIC_URL=

# Código secreto para virar administrador (veja o README). Use 32+ caracteres aleatórios.
# Depois de ativar sua conta, pode apagar esta variável.
ADMIN_SETUP_KEY=

# PIX (chave da confeiteira: CPF/CNPJ, e-mail, telefone ou chave aleatória)
PIX_KEY=
PIX_MERCHANT_NAME=DOCE MILA
PIX_CITY=RIO DE JANEIRO

# Cartão via Mercado Pago (deixe vazio para desativar)
MP_ACCESS_TOKEN=
MP_MAX_INSTALLMENTS=1

# Taxas do cardápio, em pontos-base (500 = 5%, 700 = 7%)
CARD_FEE_DEBIT_BPS=500
CARD_FEE_CREDIT_BPS=700

# Antecedência mínima da data do pedido, em dias
MIN_LEAD_DAYS=2
WHATSAPP_NUMBER=5521996911177

# --- WhatsApp Business Cloud API (opcional) ---
# Avisa o WhatsApp da confeitaria quando chega pedido/contato. Deixe vazio para desativar.
# O pedido do cliente em si é enviado pelo link wa.me e NÃO depende disto.
WA_CLOUD_TOKEN=
WA_PHONE_NUMBER_ID=
WA_NOTIFY_TO=5521996911177
# Nome do template aprovado na Meta (2 variáveis: {{1}} título, {{2}} resumo). Vazio = texto livre
WA_TEMPLATE_NAME=
WA_TEMPLATE_LANG=pt_BR
